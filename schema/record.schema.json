{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civic.aitherium.com/schema/record.schema.json",
  "title": "civic record (civic/1)",
  "description": "The envelope every file under records/ and jurisdiction.json satisfies. tools/civic_schema.py is the authority; this file documents it for editors.",
  "type": "object",
  "required": ["schema_version", "id", "kind", "title", "jurisdiction", "provenance", "privacy"],
  "properties": {
    "schema_version": {"const": "civic/1"},
    "id": {"type": "string", "minLength": 3, "maxLength": 300},
    "kind": {"enum": ["jurisdiction", "body", "office", "official", "meeting", "measure", "source"]},
    "title": {"type": "string", "maxLength": 300},
    "jurisdiction": {"type": "string", "pattern": "^jur:[a-z]{2}(-[a-z0-9]{1,3})?(::?[a-z_]+:[a-z0-9-]+)?$"},
    "privacy": {"enum": ["public-record", "public-official"]},
    "generation": {
      "type": "object",
      "required": ["generator", "at", "source_snapshot", "content_hash"],
      "properties": {
        "generator": {"type": "string"},
        "at": {"type": "string", "format": "date-time"},
        "source_snapshot": {"type": "object"},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["added_by", "added_at", "sources", "validated"],
      "properties": {
        "added_by": {"type": "string"},
        "added_at": {"type": "string", "format": "date"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_id", "url"],
            "properties": {
              "source_id": {"pattern": "^source:[0-9a-f]{16}$"},
              "url": {"type": "string", "pattern": "^https://"}
            }
          }
        },
        "validated": {
          "type": "object",
          "required": ["at", "by", "method"],
          "properties": {
            "method": {"enum": ["submitted", "source-fetched", "archived-snapshot", "generated-official", "human-review"]}
          }
        },
        "vouches": {"type": "array"},
        "evidence": {"type": "object"}
      }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "value", "by", "at", "reason"],
        "properties": {
          "path": {"type": "string"},
          "by": {"type": "string"},
          "at": {"type": "string", "format": "date"},
          "reason": {"type": "string"},
          "replaces_hash": {"type": "string"}
        }
      }
    }
  },
  "not": {
    "required": ["trust"],
    "properties": {"trust": {}}
  }
}
